APP_NAME="Academic Evaluation System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# tymon/jwt-auth — run: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
# JWT_TTL is a fallback only. Live tokens use Security Settings
# session_timeout_minutes / student_session_timeout_minutes instead.
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0
JWT_ALGO=HS256
JWT_LEEWAY=0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# When evaluator marks INC without picking a date: deadline = today + this many days (default 30 ≈ 1 month)
INC_DEFAULT_COMPLIANCE_DAYS=30

# Import capstone_db.sql into MySQL/MariaDB as database `capstone_db`, then match host/port/user below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capstone_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Google Apps Script sends forgot-password email only. Login does not send a code.
# Deploy backend-app/scripts/gscript/Code.gs as a web app (execute as you, anyone can access).
# GSCRIPT_SECRET must match SECRET_KEY inside that script.
GSCRIPT_WEB_APP_URL=https://script.google.com/macros/s/AKfycbzzJ55z-sMfwj-rBT3VBA-Iko0beFkEgWeqmio8p726RSWjsqh1PmzXMa3CjVbobm_Jog/exec
GSCRIPT_SECRET=secret_key_123
GSCRIPT_FROM_EMAIL=dmgaludo.coc@phinmaed.com
GSCRIPT_FROM_NAME="PHINMA COC"
GSCRIPT_TIMEOUT=30

# Fallback only. Used when GSCRIPT_WEB_APP_URL is empty.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-user
# MAIL_PASSWORD=your-password
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="dmgaludo.coc@phinmaed.com"
MAIL_FROM_NAME="PHINMA COC"

# React app URL used in verification / reset email links
# Public site URL for password-reset and verify-email links (defaults to APP_URL locally).
# On Railway, leave unset to use RAILWAY_PUBLIC_DOMAIN (e.g. https://academic-evaluation-system.up.railway.app).
FRONTEND_URL=http://localhost:3000
# Login does not email a code and does not block on an unverified address.
DEVICE_OTP_ENABLED=false
MAIL_REQUIRE_VERIFIED=false
MAIL_VERIFY_EXPIRE_MINUTES=60
MAIL_RESET_EXPIRE_MINUTES=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
